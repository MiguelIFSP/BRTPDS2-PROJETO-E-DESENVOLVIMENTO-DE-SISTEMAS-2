# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://user_monitoring:monitoring_password@localhost:3307/monitoring"

DATABASE="monitoring"
DATABASE_HOST="localhost"
DATABASE_PORT="3307"
DATABASE_NAME="monitoring"
DATABASE_USER="user_monitoring"
DATABASE_PASSWORD="monitoring_password"

# BetterAuth ainda não está configurado de verdade no projeto (ver "Refinamento futuro" em
# contexto-api-monitoramento.md) — troque por um valor aleatório se/quando for implementado.
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio"
BETTER_AUTH_URL="http://localhost:3333"

# Cron de health check (database + data-api + mobile-app) — ver src/jobs/healthCheck.cron.ts

# Banco da aplicação (db_better_meet, porta 3306) — checado com SELECT 1 direto, sem Prisma
APP_DATABASE_HOST="localhost"
APP_DATABASE_PORT="3306"
APP_DATABASE_USER="user_node"
APP_DATABASE_PASSWORD="node_password"
APP_DATABASE_NAME="bettermeet"

# API de Dados — usado para checar {DATA_API_URL}/health
DATA_API_URL="http://localhost:3333"

# Guard do POST /status (chamado pelo app mobile e outros serviços) — comparado com timingSafeEqual.
# Precisa ser IDÊNTICO ao EXPO_PUBLIC_MONITORING_API_KEY do .env da better-meet/
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-do-app-mobile"

# Secret do JWT emitido no /login da data-api — precisa ser IDÊNTICO ao JWT_SECRET do .env da api/
# usado pra proteger os GET /status* que o painel do app mobile consome
JWT_SECRET="troque-por-um-valor-aleatorio-igual-ao-da-api"
