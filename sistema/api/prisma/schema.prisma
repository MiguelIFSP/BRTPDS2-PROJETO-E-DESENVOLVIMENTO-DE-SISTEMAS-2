// =====================================================================
// schema.prisma — BetterMeet API
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER // usuário comum da plataforma
  ADMIN // administrador da plataforma: aprova organizações e vê os relatórios gerais
}

enum PapelOrganizacao {
  CRIADOR // quem pediu a org. so 1, nao promove para este papel
  GERENTE // max 1. adiciona e remove
  MODERADOR // max 2. so adiciona
  MEMBRO
}

enum StatusOrganizacao {
  PENDENTE // aguardando o admin da plataforma aceitar
  ACEITA // só organizações aceitas recebem membros e comissões
  RECUSADA
}

enum PapelComissao {
  ADMINISTRADOR // controle total da comissão (pode excluir a comissão)
  FACILITADOR // pode gerenciar os membros e as pautas
  SECRETARIO // focado em só registrar as atas e decisões
  MEMBRO // participante normal
}

enum StatusReuniao {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum StatusConviteReuniao {
  PENDENTE
  ACEITO
  RECUSADO
}

enum StatusAtaVoto {
  APROVADO // participante concorda com o conteúdo salvo
  REPROVADO // participante solicita revisão do conteúdo salvo
}

enum OrigemRegistroPresenca {
  PROPRIO // participante confirmou a própria presença
  MANUAL // administrador da comissão registrou por outra pessoa
}

// Tipo da votação, fixado na criação e nunca alterado.
enum TipoVotacao {
  ABERTA // quem gere a reunião vê quem votou em quê
  SECRETA // nenhuma rota liga voto e pessoa, nem ao administrador da comissão
}

enum TipoLembrete {
  MANHA // às 07h do dia da reunião
  UMA_HORA
  QUINZE_MINUTOS
}

enum TipoNotificacao {
  REUNIAO_ATUALIZADA
  REUNIAO_EXCLUIDA
}

// Valores em minúsculas porque já trafegam assim pela API e pelo app (PR-08).
enum Tema {
  light
  dark
  system // segue o tema do aparelho
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Campos exigidos pelo Better Auth; a senha fica em Account.
  emailVerified Boolean  @default(false)
  image         String?
  updatedAt     DateTime @default(now()) @updatedAt

  // -------------------------------------------------------------------
  // Preferência de tema do app mobile (UC04)
  // Valores: "light" | "dark" | "system"
  // Opcional para não quebrar usuários criados antes da migração.
  // -------------------------------------------------------------------
  themePreference Tema? @default(system)

  // -------------------------------------------------------------------
  // Relações existentes
  // -------------------------------------------------------------------
  comissoes    ComissaoEquipe[]
  organizacoes OrganizacaoMembro[]

  sessions         Session[]
  accounts         Account[]
  reunioesCriadas  Reuniao[]         @relation("ReuniaoCriador")
  votacoesCriadas  Votacao[]         @relation("VotacaoCriador")
  votos            VotacaoVoto[]
  votosAta         AtaVoto[]
  convitesReuniao  ConviteReuniao[]
  registrosReuniao ReuniaoRegistro[]
  entradasManuais  ReuniaoRegistro[] @relation("EntradaManualAutor")
  saidasManuais    ReuniaoRegistro[] @relation("SaidaManualAutor")
  notificacoes     Notificacao[]
  lembretes        LembreteEnviado[]
}

model Organizacao {
  id        Int               @id @default(autoincrement())
  nome      String
  status    StatusOrganizacao @default(PENDENTE)
  createdAt DateTime          @default(now())

  comissoes Comissao[]
  membros   OrganizacaoMembro[]
}

model OrganizacaoMembro {
  organizacaoId Int
  userId        Int
  papel         PapelOrganizacao @default(MEMBRO)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizacaoId, userId]) // o mesmo usuario nao entra duas vezes na mesma org
}

// Só existe dentro de organização ACEITA, e só membros da organização entram
// na equipe (regra do comissaoService, o banco não garante).
model Comissao {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  createdAt DateTime @default(now())

  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  equipe   ComissaoEquipe[]
  reunioes Reuniao[]
}

model ComissaoEquipe {
  comissaoId Int
  userId     Int
  papel      PapelComissao @default(MEMBRO)

  comissao Comissao @relation(fields: [comissaoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // o mesmo usuário não entra duas vezes na mesma comissão. A comissão precisa
  // ter sempre pelo menos um ADMINISTRADOR (regra do comissaoService).
  @@id([comissaoId, userId])
}

// Tabelas do Better Auth (login, sessão, recuperação de senha, e-mail
// confirmado e limite de tentativas). Os nomes dos campos são os que a
// biblioteca espera; os ids são inteiros (generateId: 'serial') para casar com
// User.id.
model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Uma credencial (providerId "credential", senha em scrypt) e, se houver, uma
// conta do Google por usuário.
model Account {
  id                    Int       @id @default(autoincrement())
  userId                Int
  accountId             String // credencial: o id do usuário; Google: o "sub" do provedor
  providerId            String // "credential" ou "google"
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt "sal:chave"; SHA-256 legado de 64 hexadecimais até o primeiro login
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Tokens de uso único: confirmação de e-mail, redefinição de senha e troca de e-mail.
model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// Contador do limite de tentativas, que sobrevive a reinício e vale para todos os processos.
model RateLimit {
  id          Int    @id @default(autoincrement())
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt
}

model Reuniao {
  id                 Int           @id @default(autoincrement())
  comissaoId         Int
  titulo             String
  pauta              String
  descricao          String?
  data               String // Data no formato AAAA-MM-DD para o contrato do app.
  horaInicio         String // Horário no formato HH:mm.
  horaFim            String // Horário no formato HH:mm.
  // Consultado/renovado somente por administrador atual da comissão.
  codigoPresenca     String?       @db.VarChar(6)
  // Endereço, link da chamada ou os dois (reunião híbrida), em texto livre.
  // Obrigatório na API; nulo só nas reuniões criadas antes do campo existir.
  local              String?       @db.VarChar(500)
  status             StatusReuniao @default(AGENDADA)
  // Nulo quando a conta de quem criou foi excluída (o app mostra "usuário removido").
  criadoPorUserId    Int?
  createdAt          DateTime      @default(now())
  conteudoAta        String?       @db.LongText
  // Impede sobrescritas e votos sobre um texto que foi alterado por outra pessoa.
  versaoAta          Int           @default(0)
  // Ata exportada: texto e votos não mudam mais. Transição: nulo -> data, uma vez, sem volta.
  ataExportadaAt     DateTime?
  ataVersaoExportada Int?

  comissao  Comissao          @relation(fields: [comissaoId], references: [id], onDelete: Cascade)
  criadoPor User?             @relation("ReuniaoCriador", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  convites  ConviteReuniao[]
  registros ReuniaoRegistro[]
  lembretes LembreteEnviado[]
  votacoes  Votacao[]
  votosAta  AtaVoto[]

  @@index([comissaoId])
  @@index([criadoPorUserId])
  @@index([data])
}

// Presença e cargo são conferidos na API. Alterar o texto invalida os votos.
model AtaVoto {
  id        Int           @id @default(autoincrement())
  reuniaoId Int
  userId    Int
  status    StatusAtaVoto
  versaoAta Int
  updatedAt DateTime      @updatedAt

  reuniao Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, userId])
  @@index([userId])
}

model ConviteReuniao {
  id            Int                  @id @default(autoincrement())
  reuniaoId     Int
  userId        Int
  status        StatusConviteReuniao @default(PENDENTE)
  createdAt     DateTime             @default(now())
  respondidoAt  DateTime?
  // Segredo dos botões Aceitar/Recusar do e-mail: quem tem o link responde
  // este convite sem login. Nulo nos convites criados antes do recurso.
  tokenResposta String?              @unique @db.VarChar(64)

  reuniao Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, userId])
  @@index([userId, status])
}

// Uma presença por integrante; repetir a entrada preserva o primeiro horário.
model ReuniaoRegistro {
  id                 Int                     @id @default(autoincrement())
  reuniaoId          Int
  userId             Int
  entradaAt          DateTime                @default(now())
  saidaAt            DateTime?
  origemEntrada      OrigemRegistroPresenca  @default(PROPRIO)
  origemSaida        OrigemRegistroPresenca?
  entradaManualPorId Int?
  saidaManualPorId   Int?

  // A origem permanece mesmo quando a conta de quem registrou é excluída.
  entradaManualPor User? @relation("EntradaManualAutor", fields: [entradaManualPorId], references: [id], onDelete: SetNull)
  saidaManualPor   User? @relation("SaidaManualAutor", fields: [saidaManualPorId], references: [id], onDelete: SetNull)

  reuniao Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, userId])
  @@index([userId])
}

// Aviso exibido no sino do app. Sem relação com Reuniao de propósito: o aviso
// de exclusão precisa continuar existindo depois que a reunião é apagada.
model Notificacao {
  id        Int             @id @default(autoincrement())
  userId    Int
  tipo      TipoNotificacao
  titulo    String
  mensagem  String          @db.Text
  reuniaoId Int?
  lidaAt    DateTime?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lidaAt])
}

// Lembretes por e-mail já tratados, um por reunião, pessoa e tipo. A chave
// única impede o envio duplicado. Remarcar a reunião apaga os registros dela,
// para os lembretes valerem de novo no horário novo.
model LembreteEnviado {
  id        Int          @id @default(autoincrement())
  reuniaoId Int
  userId    Int
  tipo      TipoLembrete
  // false: o horário passou junto com o de um lembrete mais próximo da
  // reunião, e só o mais próximo foi enviado.
  enviado   Boolean      @default(true)
  createdAt DateTime     @default(now())

  reuniao Reuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, userId, tipo])
  @@index([userId])
}

// Uma reunião tem várias votações. Opções e votos ficam em tabelas próprias:
// um campo na reunião não guarda o voto de cada pessoa nem a troca de opção.
model Votacao {
  id               Int         @id @default(autoincrement())
  reuniaoId        Int
  titulo           String      @db.VarChar(120)
  // Nulo quando a conta de quem criou foi excluída.
  criadoPorUserId  Int?
  tipo             TipoVotacao @default(ABERTA)
  // false: os totais por opção só aparecem depois do encerramento.
  mostrarParcial   Boolean     @default(false)
  // false: o voto dado não muda.
  permiteTrocaVoto Boolean     @default(false)
  // Transição: false -> true, sem volta. O fim da reunião também encerra a votação, sem gravar aqui.
  encerrada        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  reuniao   Reuniao        @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  criadoPor User?          @relation("VotacaoCriador", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  opcoes    VotacaoOpcao[]
  votos     VotacaoVoto[]

  @@index([reuniaoId])
  @@index([criadoPorUserId])
}

model VotacaoOpcao {
  id        Int    @id @default(autoincrement())
  votacaoId Int
  texto     String @db.VarChar(80)
  ordem     Int    @default(0)

  votacao Votacao       @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  votos   VotacaoVoto[]

  @@index([votacaoId])
}

// Um voto por pessoa na votação. Trocar a opção atualiza opcaoId. A votação secreta
// só é secreta pela API: o banco guarda o userId para garantir um voto por pessoa.
model VotacaoVoto {
  id        Int      @id @default(autoincrement())
  votacaoId Int
  // Nulo = voto nulo.
  opcaoId   Int?
  userId    Int
  createdAt DateTime @default(now())

  votacao Votacao       @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  opcao   VotacaoOpcao? @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([votacaoId, userId])
  @@index([opcaoId])
  @@index([userId])
}
