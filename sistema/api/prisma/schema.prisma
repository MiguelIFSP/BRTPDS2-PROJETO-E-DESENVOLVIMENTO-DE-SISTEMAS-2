// =====================================================================
// schema.prisma — BetterMeet API
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum PapelOrganizacao {
  CRIADOR
  GERENTE
  MODERADOR
  MEMBRO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  themePreference String? @default("system")

  comissoes    ComissaoEquipe[]
  organizacoes OrganizacaoMembro[]
}

model Organizacao {
  id     Int    @id @default(autoincrement())
  nome   String
  status String

  comissoes Comissao[]
  membros   OrganizacaoMembro[]
}

model OrganizacaoMembro {
  organizacaoId Int
  userId        Int
  papel         PapelOrganizacao @default(MEMBRO)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizacaoId, userId])
}

model Comissao {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?
  createdAt     DateTime @default(now())

  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  equipe ComissaoEquipe[]
}

model ComissaoEquipe {
  comissaoId Int
  userId     Int
  papel      String @default("MEMBRO")

  comissao Comissao @relation(fields: [comissaoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comissaoId, userId])
}