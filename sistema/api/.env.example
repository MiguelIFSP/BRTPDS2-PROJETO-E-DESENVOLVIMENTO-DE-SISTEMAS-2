# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.
# O start-all.ps1 cria e corrige o .env a partir deste modelo.

# Porta HTTP da API. As rotas ficam em http://localhost:PORT/api (docs em /api/docs).
PORT=3333

# Conexão com o MySQL (usuário e senha do docker-compose.yml).
DATABASE_URL="mysql://user_node:node_password@localhost:3306/bettermeet"

# Segredo do JWT emitido no /api/login. Precisa ser IDÊNTICO ao JWT_SECRET do
# .env da monitoring-better-meet/, que valida o mesmo token.
# O start-all.ps1 gera um valor aleatório; este aqui é só um exemplo.
JWT_SECRET="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"

# Administrador da plataforma, criado ao subir a API se ainda não existir.
# A senha só é usada na criação: mudar aqui não altera uma conta já existente.
# Deixe as duas vazias para não criar nenhum administrador.
# Valores de desenvolvimento; use outros em qualquer ambiente compartilhado.
ADMIN_EMAIL="admin@bettermeet.com"
ADMIN_PASSWORD="Admin123!"

# Usado só pra api se auto-reportar (POST /status como "data-api") na monitoring
# ao iniciar/parar — não bloqueia o start/stop se não estiver configurado.
MONITORING_API_URL="http://localhost:3334"
# Precisa ser IDÊNTICO ao INTERNAL_API_KEY do .env da monitoring-better-meet/
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"

# Envio de códigos por API HTTP, obrigatório ao iniciar a API (sem SMTP).
# URL completa do endpoint. Este exemplo usa o contrato do Resend.
# Outro provedor pode exigir adaptação do corpo/headers em emailService.ts.
EMAIL_API_URL="https://api.resend.com/emails"
# Chave fictícia: substitua somente no .env local pela chave do provedor.
EMAIL_API_KEY="sua-chave-do-provedor-aqui"
# Remetente autorizado no provedor; no Resend, use seu domínio verificado.
# A conta novasoft.contato@gmail.com não é um domínio próprio para verificação.
EMAIL_FROM="Better Meet <recuperacao@seu-dominio.example>"
