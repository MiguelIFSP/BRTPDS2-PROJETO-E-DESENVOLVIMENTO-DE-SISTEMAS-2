# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.
# O start-all.ps1 cria e corrige o .env a partir deste modelo.

# Porta HTTP da API. As rotas ficam em http://localhost:PORT/api (docs em /api/docs).
PORT=3333

# Conexão com o MySQL (usuário e senha do docker-compose.yml).
DATABASE_URL="mysql://user_node:node_password@localhost:3306/bettermeet"

# Segredo do Better Auth, que assina e protege as sessões e os links dos e-mails.
# Mínimo de 32 caracteres. Gere um com: openssl rand -base64 32
# O start-all.ps1 gera um valor aleatório; este aqui é só um exemplo.
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Endereço público da API, sem barra final e sem /api. É a base dos links dos
# e-mails (confirmação de e-mail e recuperação de senha), então precisa ser
# alcançável pelo celular (ex.: http://192.168.0.10:3333).
BETTER_AUTH_URL="http://localhost:3333"

# Origens de navegador autorizadas no CORS, separadas por vírgula e sem barra
# final (ex.: o painel de gestão em http://localhost:8081). Vazia = nenhuma
# origem de navegador; o aplicativo no celular não precisa constar aqui.
CORS_ORIGINS="http://localhost:8081"

# Login social com Google (opcional). Preencha as duas ou nenhuma; sem elas o
# login social fica desligado. OAuth gratuito: a credencial vem do console do
# Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Quantos proxies confiáveis ficam na frente da API (número inteiro), para o
# limite de tentativas enxergar o IP real. Vazio = nenhum.
TRUST_PROXY=""

# 'true' liga o limite de tentativas também em desenvolvimento; em produção ele
# já fica ligado.
RATE_LIMIT_ENABLED="false"

# 'production' liga o limite de tentativas e tira exp:// das origens confiáveis.
NODE_ENV="development"

# Administrador da plataforma, criado ao subir a API se ainda não existir.
# A senha só é usada na criação: mudar aqui não altera uma conta já existente.
# Deixe as duas vazias para não criar nenhum administrador.
# Valores de desenvolvimento; use outros em qualquer ambiente compartilhado.
ADMIN_EMAIL="admin@bettermeet.com"
ADMIN_PASSWORD="Admin123!"

# Usado só pra api se auto-reportar (POST /api/status como "data-api") na monitoring
# ao iniciar/parar — não bloqueia o start/stop se não estiver configurado.
MONITORING_API_URL="http://localhost:3334"
# Precisa ser IDÊNTICO ao INTERNAL_API_KEY do .env da monitoring-better-meet/ (chave só entre servidores).
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"

# E-mail de convites, avisos, confirmação de e-mail e recuperação de senha, enviado
# por uma conta do Gmail. GMAIL_APP_PASSWORD é uma "senha de app" (exige verificação
# em duas etapas na conta): https://myaccount.google.com/apppasswords
# Deixe as duas vazias para desligar o envio de e-mail.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Nome exibido como remetente.
MAIL_FROM_NAME="Better Meet"
# Endereço da API para quem abre o e-mail, usado nos botões Aceitar/Recusar do
# convite. Precisa ser acessível pelo celular/computador do convidado (o
# start-all.ps1 troca o localhost pelo IP desta máquina na rede). Deixe vazio
# para enviar o convite sem os botões.
API_PUBLIC_URL="http://localhost:3333"
# Fuso das datas e horários das reuniões (afeta o .ics e a hora dos lembretes).
TZ_REUNIOES="America/Sao_Paulo"
# Fuso do processo Node (lido pelo sistema, não pelo env.ts); mantenha igual ao
# TZ_REUNIOES para o relógio do servidor e o das reuniões não divergirem.
TZ="America/Sao_Paulo"
