# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

# URL base da API de Dados (login) — precisa ser uma conta com role ADMIN
EXPO_PUBLIC_API_URL="http://SEU_IP_AQUI:3333"

# URL base da API de monitoramento (sem o /monitoring-better-meet no final)
EXPO_PUBLIC_MONITORING_API_URL="http://SEU_IP_AQUI:3334"

# URL base da API de gestão (start/stop/restart)
EXPO_PUBLIC_MANAGEMENT_API_URL="http://SEU_IP_AQUI:3335"

# Guard do POST /status na monitoring (reportar erro do painel) — precisa ser
# IDÊNTICA ao INTERNAL_API_KEY do .env da monitoring-better-meet/
EXPO_PUBLIC_MONITORING_API_KEY="peça-esse-valor-pro-time"
