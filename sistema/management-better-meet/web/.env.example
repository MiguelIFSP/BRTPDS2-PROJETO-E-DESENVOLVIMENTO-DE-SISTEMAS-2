# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.
# Toda variável EXPO_PUBLIC_* é embutida no painel e qualquer pessoa pode lê-la:
# use só para valores públicos (URLs), nunca para chaves ou segredos.

# URL base da API de Dados (login pelo Better Auth e perfil), sem o /api no final.
# O login precisa ser de uma conta com role ADMIN.
EXPO_PUBLIC_API_URL="http://SEU_IP_AQUI:3333"

# URL base da API de monitoramento, sem o /api no final (o painel acrescenta).
EXPO_PUBLIC_MONITORING_API_URL="http://SEU_IP_AQUI:3334"

# URL base da API de gestão (start/stop/restart), sem o /api no final.
EXPO_PUBLIC_MANAGEMENT_API_URL="http://SEU_IP_AQUI:3335"
