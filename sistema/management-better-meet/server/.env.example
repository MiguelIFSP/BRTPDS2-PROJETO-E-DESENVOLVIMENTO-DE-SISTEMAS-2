# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

PORT=3335

# Precisa ser IDÊNTICO ao JWT_SECRET da api/ e da monitoring-better-meet/ — é o mesmo
# token emitido no /login da api que o painel admin vai anexar nas chamadas aqui.
JWT_SECRET="troque-por-um-valor-aleatorio-igual-ao-da-api-e-da-monitoring-better-meet"

# Usado só pra management se auto-reportar (POST /status como "management") na
# monitoring ao iniciar/parar — não bloqueia o start/stop se não estiver configurado.
MONITORING_API_URL="http://localhost:3334"
# Precisa ser IDÊNTICO ao INTERNAL_API_KEY do .env da monitoring-better-meet/
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"
