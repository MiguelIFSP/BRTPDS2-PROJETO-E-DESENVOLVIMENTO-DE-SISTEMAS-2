# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

# Porta HTTP da gestão (padrão 3335).
PORT=3335

# API de Dados (obrigatória), sem barra final e sem /api. A gestão valida a
# sessão de quem chama (GET /api/usuarios/me) e só aceita ADMIN.
DATA_API_URL="http://localhost:3333"

# Origens de navegador autorizadas no CORS, separadas por vírgula e sem barra final.
# Inclua o painel em desenvolvimento (expo start --web). Vazia = nenhuma origem de navegador.
CORS_ORIGINS="http://localhost:8081"

# Quantos proxies confiáveis ficam na frente (número inteiro), para o limite por IP enxergar o IP real. Vazio = nenhum.
TRUST_PROXY=""

# 'true' liga o limite de tentativas também em desenvolvimento; em produção ele já fica ligado.
RATE_LIMIT_ENABLED="false"

# 'production' liga o limite de tentativas.
NODE_ENV="development"

# Fuso do processo Node (lido pelo sistema, não pelo env.ts).
TZ="America/Sao_Paulo"

# Usado só pra gestão se auto-reportar (POST /api/status como "management") na
# monitoring ao iniciar/parar; não bloqueia o start/stop se não estiver configurado.
MONITORING_API_URL="http://localhost:3334"
# Precisa ser IDÊNTICO ao INTERNAL_API_KEY do .env da monitoring-better-meet/ (chave só entre servidores).
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"
