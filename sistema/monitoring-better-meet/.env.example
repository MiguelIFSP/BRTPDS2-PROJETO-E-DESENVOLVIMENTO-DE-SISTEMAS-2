# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

# Usada só pelo Prisma CLI (npm run prisma:deploy), que não carrega as variáveis DATABASE_* abaixo.
# Crie as tabelas sempre com `npm run prisma:deploy`; nunca use `prisma db push`.
# Em banco que já existe, rode antes: npx prisma migrate resolve --applied 0_init
DATABASE_URL="mysql://user_monitoring:monitoring_password@localhost:3307/monitoring"

# Banco da monitoring (lido pelo servidor, porta 3307 do docker-compose.yml).
DATABASE_HOST="localhost"
DATABASE_PORT="3307"
DATABASE_NAME="monitoring"
DATABASE_USER="user_monitoring"
DATABASE_PASSWORD="monitoring_password"

# Banco da aplicação (db_better_meet, porta 3306), checado com SELECT 1 direto, sem Prisma.
APP_DATABASE_HOST="localhost"
APP_DATABASE_PORT="3306"
APP_DATABASE_USER="user_node"
APP_DATABASE_PASSWORD="node_password"
APP_DATABASE_NAME="bettermeet"

# API de Dados (obrigatória), sem barra final e sem /api. Serve para checar
# {DATA_API_URL}/health e para validar a sessão de quem chama (GET /api/usuarios/me).
DATA_API_URL="http://localhost:3333"

# API de gestão, usada para checar {MANAGEMENT_API_URL}/health.
MANAGEMENT_API_URL="http://localhost:3335"

# Chave interna, só entre servidores (a api e a gestão reportam o próprio status por ela).
# Precisa ser IDÊNTICA ao INTERNAL_API_KEY dos .env da api/ e da management-better-meet/server/.
# Nunca vai para o aplicativo nem para o painel.
INTERNAL_API_KEY="troque-por-um-valor-aleatorio-igual-ao-da-api"

# Porta HTTP da monitoring (padrão 3334). As rotas ficam em http://localhost:PORT/api.
PORT=3334

# Origens de navegador autorizadas no CORS, separadas por vírgula e sem barra final
# (ex.: o painel de gestão em http://localhost:8081). Vazia = nenhuma origem de navegador.
CORS_ORIGINS="http://localhost:8081"

# Quantos proxies confiáveis ficam na frente (número inteiro), para o limite por IP enxergar o IP real. Vazio = nenhum.
TRUST_PROXY=""

# 'true' liga o limite de tentativas também em desenvolvimento; em produção ele já fica ligado.
RATE_LIMIT_ENABLED="false"

# 'production' liga o limite de tentativas.
NODE_ENV="development"

# Fuso do processo Node (lido pelo sistema, não pelo env.ts): o histórico diário usa America/Sao_Paulo.
TZ="America/Sao_Paulo"
