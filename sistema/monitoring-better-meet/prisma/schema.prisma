generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Parte do sistema monitorada. Nasce na primeira vez que reporta (upsert), sem seed.
model SubSystem {
  id     Int           @id @default(autoincrement())
  name   String        @unique // "mobile-app", "data-api", "database", "management", "monitoring", "monitoring-database"
  checks StatusCheck[]
}

enum StatusType {
  OPERATIONAL // funcionando normalmente
  MAINTENANCE // parada planejada ou solicitada (ex.: comando do PM2)
  ERROR // funciona com falha parcial; o app e o painel reportam
  DOWN // sem resposta
  UNKNOWN // ainda sem nenhuma checagem
}

// Cada checagem é um registro novo (histórico); o status atual é o mais recente.
model StatusCheck {
  id          Int        @id @default(autoincrement())
  subSystemId Int
  subSystem   SubSystem  @relation(fields: [subSystemId], references: [id], onDelete: Cascade)
  status      StatusType
  message     String? @db.VarChar(500) // texto livre de quem reportou; nunca erro interno bruto
  isBlocking  Boolean    @default(false) // true quando o problema impede o uso do aplicativo
  checkedAt   DateTime   @default(now())

  @@index([subSystemId, checkedAt])
}
