# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.
# Toda variável EXPO_PUBLIC_* é embutida no aplicativo e qualquer pessoa pode lê-la:
# use só para valores públicos (URLs), nunca para chaves ou segredos.

# URL base da API de Dados (login, usuários, organizações), já com o prefixo /api.
# Use o IP da máquina rodando a api/ na sua rede local (ex.: 192.168.0.X) quando testar num
# dispositivo físico ou emulador Android — "localhost" só funciona no simulador iOS.
EXPO_PUBLIC_API_URL="http://SEU_IP_AQUI:3333/api"

# URL base da API de Monitoramento, já com o prefixo das rotas dela (a monitoring não usa /api).
# Mesma regra de IP acima.
EXPO_PUBLIC_MONITORING_API_URL="http://SEU_IP_AQUI:3334/monitoring-better-meet"
