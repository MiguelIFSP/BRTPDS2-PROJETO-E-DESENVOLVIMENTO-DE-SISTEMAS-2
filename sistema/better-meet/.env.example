# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

# URL base da API de Dados (login, usuários, organizações)
# Use o IP da máquina rodando a api/ na sua rede local (ex.: 192.168.0.X) quando testar num
# dispositivo físico ou emulador Android — "localhost" só funciona no simulador iOS.
EXPO_PUBLIC_API_URL="http://SEU_IP_AQUI:3333"

# URL base da API de monitoramento (sem o /monitoring-better-meet no final) — mesma regra de IP acima
EXPO_PUBLIC_MONITORING_API_URL="http://SEU_IP_AQUI:3334"

# Precisa ser igual ao INTERNAL_API_KEY do .env da monitoring-better-meet/ — peça o valor pro time
EXPO_PUBLIC_MONITORING_API_KEY="peça-esse-valor-pro-time"
