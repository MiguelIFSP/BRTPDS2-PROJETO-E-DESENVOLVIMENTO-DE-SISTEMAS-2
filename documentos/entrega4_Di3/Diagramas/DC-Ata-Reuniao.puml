}
class Comissao <<Prisma model>> {
  id : Int
  nome : String
  descricao : String?
  createdAt : DateTime
  organizacaoId : Int
}
class ComissaoEquipe <<Prisma model>> {
  comissaoId : Int
  userId : Int
