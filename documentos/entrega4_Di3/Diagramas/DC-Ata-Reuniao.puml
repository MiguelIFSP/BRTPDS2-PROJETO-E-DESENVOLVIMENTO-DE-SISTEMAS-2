}
class Reuniao <<Prisma model>> {
  id : Int
  comissaoId : Int
  titulo : String
  pauta : String
  descricao : String?
  data : String
  horaInicio : String
  horaFim : String
  local : String?
  status : StatusReuniao
  criadoPorUserId : Int
  createdAt : DateTime
  conteudoAta : String?
  versaoAta : Int
}
class ReuniaoRegistro <<Prisma model>> {
  id : Int
  reuniaoId : Int
  userId : Int
  entradaAt : DateTime
  saidaAt : DateTime?
}
class AtaVoto <<Prisma model>> {
  id : Int
  reuniaoId : Int
  userId : Int
  status : StatusAtaVoto
