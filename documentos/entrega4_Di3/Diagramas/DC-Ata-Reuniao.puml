title Ata de Reunião — modelo de persistência Prisma
class User <<Prisma model>> {
  id : Int
  name : String
  email : String
  password : String
  role : Role
  createdAt : DateTime
  themePreference : Tema?
}
class Organizacao <<Prisma model>> {
  id : Int
  nome : String
  status : StatusOrganizacao
