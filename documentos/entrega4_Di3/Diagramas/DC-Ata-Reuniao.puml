}
enum Role <<enumeration>> {
  USER
  ADMIN
}
enum Tema <<enumeration>> {
  light
  dark
  system
}
enum StatusOrganizacao <<enumeration>> {
  PENDENTE
  ACEITA
  RECUSADA
}
enum PapelComissao <<enumeration>> {
  ADMINISTRADOR
  FACILITADOR
  SECRETARIO
  MEMBRO
}
enum StatusReuniao <<enumeration>> {
  AGENDADA
  REALIZADA
  CANCELADA
}
enum StatusAtaVoto <<enumeration>> {
  APROVADO
  REPROVADO
}
