@startuml DCU-Configuracoes-de-Usuario
' Diagrama de casos de uso (UML) — Configurações de Usuário (UC12 a UC15)
' Gerar o SVG: java -jar plantuml.jar -tsvg "DCU-Configuracoes-de-Usuario.puml"
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Usuário comum" as AUsu
actor "Administrador" as AAdm

rectangle "Configurações de Usuário (Data API + App Mobile)" {
  usecase "UC12 - Trocar senha" as UC12
  usecase "UC13 - Recuperar conta\n(sem sessão ativa)" as UC13
  usecase "UC14 - Alterar dados\npessoais" as UC14
  usecase "UC15 - Alterar tema\npreferido" as UC15
}

AUsu -- UC12
AUsu -- UC13
AUsu -- UC14
AUsu -- UC15
AAdm -- UC12
AAdm -- UC13
AAdm -- UC14
AAdm -- UC15

note bottom of UC13
  Rota pública: quem perdeu a senha não tem token.
  Hoje sem confirmação de posse do e-mail.
end note
@enduml
