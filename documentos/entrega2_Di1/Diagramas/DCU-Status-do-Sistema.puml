@startuml DCU-Status-do-Sistema
' Diagrama de casos de uso (UML) — Status do Sistema e dos Subsistemas (UC16 a UC21)
' Gerar o SVG: java -jar plantuml.jar -tsvg "DCU-Status-do-Sistema.puml"
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Usuário comum" as AUsu
actor "Administrador" as AAdm
actor "Cron de\nMonitoramento\n(tempo)" as ACron
actor "App Mobile\n(Better Meet)" as AApp
actor "Painel de Gestão\n(web)" as APai
actor "API de Gestão" as AGes
actor "Script de setup\n(start-all.ps1)" as AScr

rectangle "API de Monitoramento" {
  usecase "UC16 - Consultar status\natual dos subsistemas" as UC16
  usecase "UC17 - Consultar relatório\ndiário de status" as UC17
  usecase "UC18 - Consultar histórico\nde um subsistema" as UC18
  usecase "UC19 - Executar checagem\nperiódica dos subsistemas" as UC19
  usecase "UC20 - Reportar status\nde um subsistema" as UC20
  usecase "UC21 - Disparar checagem\nimediata de um subsistema" as UC21
}

AUsu -- UC16
AUsu -- UC17
AUsu -- UC18
AAdm -- UC16
AAdm -- UC17
AAdm -- UC18
ACron -- UC19
AApp -- UC20
APai -- UC20
AGes -- UC20
AApp -- UC21
APai -- UC21
AScr -- UC21

note bottom of UC17
  Implementado, mas nenhuma tela
  usa este endpoint hoje.
end note
@enduml
