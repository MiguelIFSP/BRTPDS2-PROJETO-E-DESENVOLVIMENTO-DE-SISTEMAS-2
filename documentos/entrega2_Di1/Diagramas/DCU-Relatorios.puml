@startuml DCU-Relatorios
' Diagrama de casos de uso (UML) — Relatórios de Usuários, Organizações e Comissões (UC28 a UC31)
' Gerar o SVG: java -jar plantuml.jar -tsvg "DCU-Relatorios.puml"
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Usuário comum" as AUsu
actor "Administrador" as AAdm

rectangle "Relatórios (Data API + App Mobile)" {
  usecase "UC28 - Consultar relatório\nde organizações" as UC28
  usecase "UC29 - Consultar relatório\nde comissões" as UC29
  usecase "UC30 - Consultar relatório\nde usuários\n--\nextension points\ndetalhes do usuário" as UC30
  usecase "UC31 - Alterar o perfil\nde um usuário" as UC31
}

AUsu -- UC28
AUsu -- UC29
AAdm -- UC28
AAdm -- UC29
AAdm -- UC30
AAdm -- UC31

UC31 .> UC30 : <<extend>>
note on link
  condição: no painel de detalhes de
  outro usuário, o administrador toca em
  "Tornar administrador" ou "Tornar usuário comum"
  ponto de extensão: detalhes do usuário
end note
@enduml
