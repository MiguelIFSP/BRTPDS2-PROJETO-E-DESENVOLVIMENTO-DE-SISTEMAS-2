@startuml DCU-Gestao-Setup-Reset
' Diagrama de casos de uso (UML) — Reinicialização de Subsistemas, Setup Inicial e Reset (UC22 a UC27)
' Gerar o SVG: java -jar plantuml.jar -tsvg "DCU-Gestao-Setup-Reset.puml"
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Administrador" as A1
actor "Administrador\ndo Servidor" as A0

rectangle "API de Gestão (management-better-meet) e Infraestrutura" {
  usecase "UC22 - Autenticar\nadministrador" as UC22
  usecase "UC23 - Iniciar, parar ou\nreiniciar um subsistema" as UC23
  usecase "UC24 - Reiniciar a própria\nAPI de Gestão" as UC24
  usecase "UC25 - Reportar o próprio\nstatus ao iniciar ou parar" as UC25
  usecase "UC26 - Subir o ambiente\ncompleto (setup inicial)" as UC26
  usecase "UC27 - Resetar o sistema\n--\nextension points\nencerrar os subsistemas" as UC27
}

actor "PM2" as A2
actor "Docker Engine" as A3
actor "API de\nMonitoramento" as A4

A1 -- UC22
A1 -- UC23
A1 -- UC24
A0 -- UC26
A0 -- UC27

' UC24 é um caso especial (especialização) do UC23
UC24 -|> UC23

' Parar pelo painel/app é opcional dentro do reset
UC23 .> UC27 : <<extend>>
note on link
  condição: o administrador escolhe
  parar os subsistemas pelo painel
  ou pelo app (UC23/UC24)
  ponto de extensão: encerrar os subsistemas
end note
' A reinicialização faz parte do fluxo principal do reset
UC27 .> UC26 : <<include>>

UC23 -- A2
UC23 -- A3
UC23 -- A4
UC24 -- A2
UC25 -- A2
UC25 -- A4
UC26 -- A2
UC26 -- A3
UC26 -- A4
UC27 -- A2
UC27 -- A3
@enduml
