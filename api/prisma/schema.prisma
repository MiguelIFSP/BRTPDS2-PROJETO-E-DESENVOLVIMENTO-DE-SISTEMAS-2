// /prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // um usuário pode participar de várias comissões
  comissoes ComissaoEquipe[]
  solicitacoesOrganizacao Organizacao[] @relation("SolicitanteOrganizacao")
  organizacoes OrganizacaoMembro[]
}


model Organizacao {
  id        Int        @id @default(autoincrement())
  nome      String
  status      String  // aceito ou nao aceito pelo admin
  
  //uma organização possui várias comissões
  comissoes Comissao[]
  solicitanteId Int?
  solicitante User? @relation("SolicitanteOrganizacao", fields: [solicitanteId], references: [id])
  membros OrganizacaoMembro[]
}

model OrganizacaoMembro {
  organizacaoId Int
  userId Int
  papel String @default("MEMBRO")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizacaoId, userId])
}



model Comissao {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?  // deixei aq mas nao sei se voui manter
  createdAt     DateTime @default(now())

  // relacionamento com a organização (toda comissão pertence a uma organização)
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  // relacionamento com a tabela intermediária de equipe
  equipe        ComissaoEquipe[]
}

model ComissaoEquipe {
  comissaoId Int
  userId     Int
  papel      String   @default("MEMBRO") 

  // configuração das chaves estrangeiras
  comissao   Comissao @relation(fields: [comissaoId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // chave primária composta: garante que o mesmo usuário não seja inserido duas vezes na mesma comissão
  @@id([comissaoId, userId])
}