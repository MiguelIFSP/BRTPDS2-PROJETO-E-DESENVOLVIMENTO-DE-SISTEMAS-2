# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

PORT=3333
DATABASE_URL="mysql://user_node:node_password@localhost:3306/bettermeet"

# Secret do JWT emitido no /login — precisa ser IDÊNTICO ao JWT_SECRET do .env da monitoring-better-meet/
# (é o token que o app mobile vai anexar nas chamadas GET /status* da API de monitoramento)
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e use o MESMO valor nos dois .env — peça pro time se já existir um combinado.
JWT_SECRET="troque-por-um-valor-aleatorio-igual-ao-da-monitoring-better-meet"
