# Copie este arquivo para .env e preencha os valores reais. O .env não é versionado.

PORT=3335

# Precisa ser IDÊNTICO ao JWT_SECRET da api/ e da monitoring-better-meet/ — é o mesmo
# token emitido no /login da api que o painel admin vai anexar nas chamadas aqui.
JWT_SECRET="troque-por-um-valor-aleatorio-igual-ao-da-api-e-da-monitoring-better-meet"
